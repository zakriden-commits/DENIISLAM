# For Docker Compose. Copy to .env and set a private code; never commit .env.
ROOM_CODE=change-this-private-code
# Optional: necessary for reliable voice across restrictive mobile networks.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
